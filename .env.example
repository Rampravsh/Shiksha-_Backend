# ==================================================
# SHIKSHA+ BACKEND PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION
# ==================================================

# --------------------------------------------------
# APPLICATION CONFIGURATION
# --------------------------------------------------
NODE_ENV=production
PORT=5000
APP_NAME=shiksha-api
API_PREFIX=/api/v1
CORS_ORIGIN=https://your-frontend-domain.com

# --------------------------------------------------
# NEON POSTGRESQL & PRISMA ORM
# --------------------------------------------------
# For Neon PostgreSQL serverless database:
# DATABASE_URL="postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/shiksha_db?sslmode=require&pgbouncer=true&connection_limit=20"
DATABASE_URL=postgresql://shiksha_user:shiksha_secure_password_123@localhost:5432/shiksha_db?schema=public

# --------------------------------------------------
# JWT AUTHENTICATION
# --------------------------------------------------
JWT_ACCESS_SECRET=your_production_super_secret_jwt_access_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_production_super_secret_jwt_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------------------------------
# CLOUDINARY CONFIGURATION (MEDIA STORAGE)
# --------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_production_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_production_cloudinary_api_key
CLOUDINARY_API_SECRET=your_production_cloudinary_api_secret

# --------------------------------------------------
# FIREBASE ADMIN SDK (AUTH VERIFICATION & FCM PUSH)
# --------------------------------------------------
FIREBASE_PROJECT_ID=shiksha-plus-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@shiksha-plus-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRODUCTION_FIREBASE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --------------------------------------------------
# LOGGING CONFIGURATION (PINO)
# --------------------------------------------------
LOG_LEVEL=info

# --------------------------------------------------
# RATE LIMITING
# --------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
